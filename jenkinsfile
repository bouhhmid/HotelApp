pipeline {
    agent any

    tools {
        maven 'M2_HOME'
        jdk 'JAVA_HOME'
    }

    environment {
        IMAGE_NAME = "ahmedbencheikh666/HotelApp"
        IMAGE_TAG = "latest"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "📥 Cloning project from GitHub..."
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo "⚙️ Building with CI profile (H2 disabled)..."
                sh 'mvn clean install -DskipTests=true -Dspring.profiles.active=ci'
            }
        }

        stage('Package') {
            steps {
                echo "📦 Packaging application WITHOUT tests..."
                sh 'mvn package -DskipTests=true -Dspring.profiles.active=ci'
            }
        }

        stage('Archive Artifact') {
            steps {
                echo "🗂️ Archiving .jar artifact..."
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }
          stage('Build Docker Image') {
                    steps {
                        script {
                            echo "🐳 Building Docker image..."
                            sh """
                                docker build -t $IMAGE_NAME:$IMAGE_TAG .
                            """
                        }
                    }
        }




    }

    post {
        success {
            echo "🎉 BUILD SUCCESSFUL!"
        }
        failure {
            echo "❌ PIPELINE FAILED — CHECK LOGS"
        }
    }
}
